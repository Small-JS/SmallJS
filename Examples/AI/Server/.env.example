# The port the AI server runs on:
AI_SERVER_PORT=3000

# =============================== AI providers

# An AI provider below is enabled when its *_BASE_URL and *_MODELS variables are set,
# and, except for Ollama, also its *_API_KEY variable.
# Ollama can be installed and run locally.
# For the others, you have to get/buy API keys, put them in their *_API_KEY variables and uncomment those.
# The models listed are a selection of available models,
# with the fast/cheap (default) models listed first.
# These models where updated last on: 15-DEC-2025.

# Ollama / Llama*
# Download Ollama for local setup here: https://ollama.com
# Ollama does not have API key access.
# Comment out OLLAMA_BASE_URL to disable it.
# Look here for currently installable models: https://ollama.com/library
# The model named below is the small model suitable for API testing.
# Embedding models are optional, uncomment to also test embedding.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODELS="qwen:4b"
# OLLAMA_EMBEDDING_MODELS="nomic-embed-text"

# OpenAI / GPT*
# Look here for current models: https://platform.openai.com/docs/models
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODELS="gpt-6-luna gpt-6.1-sol gpt-6-astra"
# OPENAI_API_KEY="<put your secret API key here>"

# DeekSeek / V*, R*
# Look here for current models: https://api-docs.deepseek.com/quick_start/pricing
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODELS="deepseek-flash deepseek-v4-pro"
# DEEPSEEK_API_KEY="<put your secret API key here>"

# Google AI / Gemini
# Look here for current models: https://deepmind.google/models/
GOOGLEAI_BASE_URL="https://generativelanguage.googleapis.com"
GOOGLEAI_MODELS="gemini-3.5-flash-lite gemini-3.8-flash gemini-3.1-pro-preview"
# GOOGLEAI_API_KEY="<put your secret API key here>"

# Anthropic / Claude
# Look here for current models: https://docs.anthropic.com/en/docs/about-claude/models/overview
ANTHROPIC_BASE_URL="https://api.anthropic.com"
ANTHROPIC_MODELS="claude-haiku-5-5 claude-sonnet-5-5 claude-opus-5-5 claude-fable-5-1"
# ANTHROPIC_API_KEY="<put your secret API key here>"
