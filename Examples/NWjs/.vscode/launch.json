{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "NW",
			"type": "nwjs",
			"request": "launch",
			"skipFiles": [ "**/Runtime.js" ],
			// The debugger needs the SDK flavor of NW.js, which is installed by npm (see package.json).
			// ./nwjs is a link to its versioned folder in node_modules/nw, created by install.sh.
			"runtimeExecutable": "${workspaceRoot}/nwjs/nw",
			"osx" : {
				"runtimeExecutable": "${workspaceRoot}/nwjs/nwjs.app/Contents/MacOS/nwjs" },
			"windows" : {
			 	"runtimeExecutable": "${workspaceRoot}/nwjs/nw.exe" },
			"runtimeArgs": [
				"${workspaceRoot}/web",
				"--enable-features=NWESM,NWChainImportNode"
			],
			"webRoot": "${workspaceRoot}/web",
			"sourceMaps": true,
			"port": 9222,
			// If this is set to false, a small (~500 msec) delay must be done before starting the app
			// to allow the debugger to attach before the main page is loaded.
			"reloadAfterAttached": false,
			"preLaunchTask": "Compile Smalltalk"
		},
		{
			"name": "NW Test",
			"type": "nwjs",
			"request": "launch",
			"skipFiles": [ "**/Runtime.js" ],
			// The debugger needs the SDK flavor of NW.js, which is installed by npm (see package.json).
			// ./nwjs is a link to its versioned folder in node_modules/nw, created by install.sh.
			"runtimeExecutable": "${workspaceRoot}/nwjs/nw",
			"osx" : {
				"runtimeExecutable": "${workspaceRoot}/nwjs/nwjs.app/Contents/MacOS/nwjs" },
			"windows" : {
			 	"runtimeExecutable": "${workspaceRoot}/nwjs/nw.exe" },
			"runtimeArgs": [
				"${workspaceRoot}/web",
				"--enable-features=NWESM,NWChainImportNode",
				"-test"
			],
			"webRoot": "${workspaceRoot}/web",
			"sourceMaps": true,
			"port": 9222,
			// If this is set to false, a small (~500 msec) delay must be done before starting the app
			// to allow the debugger to attach before the main page is loaded.
			"reloadAfterAttached": false,
			"preLaunchTask": "Compile Smalltalk"
		}
	]
}
